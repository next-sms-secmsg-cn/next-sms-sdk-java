    },
    {
      "key": "extCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "sId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sendTime",
      "value": "",
      "type": "string"
    },
    {
      "key": "date",
      "value": "20261118",
      "type": "string"
    },
    {
      "key": "maxSize",
      "value": "500",
      "type": "string"
    },
    {
      "key": "confirmSend",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "getBalance",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{{requestBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
